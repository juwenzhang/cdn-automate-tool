{
  "$schema": "https://biomejs.dev/schemas/2.3.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "src/**/*.ts",
      "types/**/*.ts",
      "!node_modules/**/*",
      "!**/*.spec.ts",
      "!**/*.test.ts",
      "!**/*.spec.ts.ts",
      "!**/dist",
      "!**/*.generated.js"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    },
    "includes": [
      "src/**/*.ts",
      "types/**/*.ts",
      "!node_modules/**/*",
      "!**/*.spec.ts",
      "!**/*.test.ts",
      "!**/*.spec.ts.ts",
      "!**/dist",
      "!**/*.generated.js"
    ]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "lineWidth": 100
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
